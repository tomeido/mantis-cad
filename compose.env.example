# OCI tag or digest used by compose.yaml.
MANTIS_IMAGE=ghcr.io/tomeido/mantis-cad:latest

# Host loopback port. The container always listens on 7878.
MANTIS_PORT=7878

# Comma-separated Ed25519 public keys permitted to create projects.
MANTIS_OPERATOR_KEYS=

# Leave empty for same-origin. Add exact, comma-separated development origins.
MANTIS_ALLOWED_ORIGINS=

# Maximum serialized chain size for one project (24 MiB). The server reserves
# headroom under its separate 32 MiB complete signed-document/request cap.
MANTIS_MAX_PROJECT_BYTES=25165824
